{
  "name": "jufexk",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "prototype": "vite",
    "prototype:course-reviews": "vite --config prototypes/course-review-ui/vite.config.ts --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run && vitest run --config vitest.node.config.ts && vitest run --config vitest.legacy-evidence.config.ts && vitest run --config vitest.catalog-baseline.config.ts && vitest run --config vitest.secrets.config.ts",
    "test:legacy-evidence": "vitest run --config vitest.legacy-evidence.config.ts",
    "test:catalog-baseline": "vitest run --config vitest.catalog-baseline.config.ts",
    "test:browser": "playwright test",
    "test:historical-import-drill": "vitest run test/historical-local-import-drill.test.ts",
    "test:legacy-ocr-contract": "uv run --directory scripts/legacy_ocr --with openpyxl --with pandas==3.0.3 python -m unittest test_approval.py test_compile_production_staging.py test_compile_historical_approved_package.py test_freeze_historical_production_package.py test_freeze_issue111_historical_package.py test_build_unresolved_authority_reconciliation.py test_compile_catalog_augmentation_requests.py test_map_catalog_identities.py test_approve_catalog_additions.py test_build_review_workbook.py test_formula_bar_rebuild.py test_compile_issue98_followup.py test_ocr_review_cells.py",
    "build:catalog-userscript": "node scripts/catalog-baseline/build-userscript.mjs",
    "validate:catalog-capture": "tsx scripts/catalog-baseline/validate-capture.ts",
    "audit:catalog-pilot": "tsx scripts/catalog-baseline/audit-pilot.ts",
    "audit:catalog-full": "tsx scripts/catalog-baseline/audit-full.ts",
    "catalog-baseline": "tsx scripts/catalog-baseline/cli.ts",
    "legacy-evidence": "tsx scripts/legacy_evidence/cli.ts",
    "formula-bar-smoke": "tsx scripts/legacy_evidence/formula_bar_smoke_cli.ts",
    "formula-bar-full-audit": "tsx scripts/legacy_evidence/formula_bar_full_scan_cli.ts",
    "legacy-review-package": "tsx scripts/legacy_evidence/review_package_cli.ts",
    "legacy-matrix-freeze": "tsx scripts/legacy_evidence/matrix_freeze_cli.ts",
    "smoke-recapture": "tsx scripts/legacy_evidence/smoke_recapture_cli.ts",
    "other-smoke": "tsx scripts/legacy_evidence/other_smoke_cli.ts",
    "legacy-production-gap": "tsx scripts/legacy_evidence/production_gap_cli.ts",
    "rest-sheets-capture": "tsx scripts/legacy_evidence/rest_sheets_capture_cli.ts",
    "smoke-rest-capture": "tsx scripts/legacy_evidence/smoke_rest_capture_cli.ts",
    "live-layout-context-index": "tsx scripts/legacy_evidence/live_layout_context_index_cli.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit && pnpm test && pnpm run test:browser && pnpm run test:legacy-ocr-contract && vite build && wrangler deploy --dry-run",
    "db:local": "wrangler d1 migrations apply jufexk --local",
    "db:seed-preview": "wrangler d1 execute jufexk --local --file=scripts/prototype-local-seed.sql",
    "db:export-remote": "mkdir -p .local-data && wrangler d1 export jufexk --remote --output=.local-data/remote-export.sql -y",
    "db:import-remote-local": "python3 scripts/import-remote-export-local.py",
    "historical-import:production": "tsx scripts/historical-import/publish-production.ts",
    "catalog-relations:production": "tsx scripts/catalog-relation-additions/publish-production.ts",
    "historical-import:issue111": "tsx scripts/historical-import/publish-issue111.ts",
    "secrets:sync-local": "tsx scripts/secrets/sync-local.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "hono": "4.13.2",
    "pinyin-pro": "^3.29.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "0.28.1",
    "iconv-lite": "^0.7.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
