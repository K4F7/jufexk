{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jufexk",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "courses.sein.moe", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jufexk",
      "database_id": "7bd119f3-b8a2-4c9d-9e70-2809396ee26c",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "AI_SUMMARY_QUEUE", "queue": "jufexk-ai-summary" },
    ],
    "consumers": [
      {
        "queue": "jufexk-ai-summary",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 30,
        "dead_letter_queue": "jufexk-ai-summary-dlq",
        "max_concurrency": 2,
      },
    ],
  },
  "vars": {
    "SITE_NAME": "非官方课评@JUFE",
    "UNIVERSITY_NAME": "江西财经大学",
    "ISSUE111_RELATION_MANIFEST_SHA256": "edb9c07dc31990de02fb3d22c5a4c9141e931a7b49d68fa64eb8ae55dd0ae34b",
    "V5_IMPORT_ARTIFACT_SHA256": "4bfcf6008c2539494d4f3b4346d4c6e958144a3f0d83a06c4095ce472a1974dd",
    "V5_IMPORT_MANIFEST_SHA256": "a0889ee7ebba559af4179ff4331de5c3324ae7da89ab1d17b6c735afe0576266",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD2pZlHJDQEqRlVH",
    // OPENAI_MODEL is a dashboard-only var (live: grok-4.5). Do not commit it
    // here — an empty or omitted value without keep_vars wipes the dashboard.
  },
  // Keep dashboard vars such as OPENAI_MODEL across wrangler deploy.
  "keep_vars": true,
  "secrets_store_secrets": [
    {
      "binding": "IP_HASH_SECRET",
      "store_id": "323163a091874b07aacdf5500bff903e",
      "secret_name": "IP_HASH_SECRET",
    },
    {
      "binding": "TURNSTILE_SECRET",
      "store_id": "323163a091874b07aacdf5500bff903e",
      "secret_name": "TURNSTILE_SECRET",
    },
    {
      "binding": "CAMPUS_IDENTITY_SECRET",
      "store_id": "323163a091874b07aacdf5500bff903e",
      "secret_name": "CAMPUS_IDENTITY_SECRET",
    },
    {
      "binding": "CAS_CHALLENGE_SECRET",
      "store_id": "323163a091874b07aacdf5500bff903e",
      "secret_name": "CAS_CHALLENGE_SECRET",
    },
    // OPENAI_BASE_URL / OPENAI_API_KEY are Worker secrets set in the dashboard.
    // Do not bind them as Secrets Store entries — that replaces the Worker
    // secrets on deploy and the store does not hold those values.
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "placement": { "mode": "smart" },
  "cache": { "enabled": true },
}
