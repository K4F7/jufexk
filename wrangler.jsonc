{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jufexk",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "xk.sein.moe", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jufexk",
      "database_id": "7bd119f3-b8a2-4c9d-9e70-2809396ee26c",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "SITE_NAME": "非官方课评@JUFE",
    "UNIVERSITY_NAME": "江西财经大学",
    "HISTORICAL_IMPORT_ARTIFACT_SHA256": "778345ca9e437f3706abf93ca7840d6999089b5772d618395ca05fbeb2982ea4",
    "HISTORICAL_IMPORT_MANIFEST_SHA256": "96035445669d14f19dd469bf51161236f0a1010507c53f20e7f925fae0d82adf",
    "ISSUE111_RELATION_MANIFEST_SHA256": "edb9c07dc31990de02fb3d22c5a4c9141e931a7b49d68fa64eb8ae55dd0ae34b",
    "ISSUE111_IMPORT_ARTIFACT_SHA256": "manifest",
    "ISSUE111_IMPORT_MANIFEST_SHA256": "manifest",
    "V5_IMPORT_ARTIFACT_SHA256": "4bfcf6008c2539494d4f3b4346d4c6e958144a3f0d83a06c4095ce472a1974dd",
    "V5_IMPORT_MANIFEST_SHA256": "a0889ee7ebba559af4179ff4331de5c3324ae7da89ab1d17b6c735afe0576266",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD2pZlHJDQEqRlVH",
    "CAMPUS_JWT_AUD": "jufexk",
    "CAMPUS_APP_ID": "jufexk",
    "AUTHBRIDGE_BASE_URL": "https://mc.jxufe.edu.cn/authbridge",
    "MAIL_DELIVERY_URL": "https://api.resend.com/emails",
    "MAIL_FROM": "\"非官方课评@JUFE\" <noreply@sein.moe>",
  },
  "secrets_store_secrets": [
    {
      "binding": "ADMIN_PASSWORD",
      "store_id": "323163a091874b07aacdf5500bff903e",
      "secret_name": "ADMIN_PASSWORD",
    },
    {
      "binding": "IP_HASH_SECRET",
      "store_id": "323163a091874b07aacdf5500bff903e",
      "secret_name": "IP_HASH_SECRET",
    },
    {
      "binding": "TURNSTILE_SECRET",
      "store_id": "323163a091874b07aacdf5500bff903e",
      "secret_name": "TURNSTILE_SECRET",
    },
    {
      "binding": "CAMPUS_JWT_SECRET",
      "store_id": "323163a091874b07aacdf5500bff903e",
      "secret_name": "CAMPUS_JWT_SECRET",
    },
    {
      "binding": "CAMPUS_JWT_AES_KEY",
      "store_id": "323163a091874b07aacdf5500bff903e",
      "secret_name": "CAMPUS_JWT_AES_KEY",
    },
    {
      "binding": "CAMPUS_IDENTITY_SECRET",
      "store_id": "323163a091874b07aacdf5500bff903e",
      "secret_name": "CAMPUS_IDENTITY_SECRET",
    },
    {
      "binding": "MAIL_DELIVERY_TOKEN",
      "store_id": "323163a091874b07aacdf5500bff903e",
      "secret_name": "MAIL_DELIVERY_TOKEN",
    },
    {
      "binding": "CAS_CHALLENGE_SECRET",
      "store_id": "323163a091874b07aacdf5500bff903e",
      "secret_name": "CAS_CHALLENGE_SECRET",
    },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "cache": { "enabled": true },
}
